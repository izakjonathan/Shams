# Optional until the final custom domain is connected.
# On Vercel, metadata automatically falls back to the current deployment URL.
NEXT_PUBLIC_SITE_URL=

# Keep false on previews. Change to true only for the public launch deployment.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Public ticket checkout URL. The site shows “Tickets soon” when omitted.
NEXT_PUBLIC_TICKET_URL=

# HTTPS form endpoint supplied by the final newsletter provider.
# The newsletter form remains visibly unavailable when omitted.
NEXT_PUBLIC_NEWSLETTER_FORM_ACTION=

# Admin, PostgreSQL, database-backed public content, and Draft Mode preview.
# Keep CONTENT_SOURCE=local until migrations, seeding, and preview QA pass.
DATABASE_URL=
# Per-instance pool size; 1–10, default 3. Use 1 for isolated PGlite HTTP checks.
DATABASE_POOL_MAX=3
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Use a random value of at least 32 characters.
ADMIN_SESSION_SECRET=

# Public content source: local | database
CONTENT_SOURCE=local
# Database failure policy in database mode: error | local-fallback
CONTENT_DATABASE_FAILURE=error

# Enable only after previews use an isolated database branch.
ALLOW_PREVIEW_DATABASE_WRITES=false

# Recommended: Vercel Blob for new gallery/artist uploads.
# Create a public Blob store in Vercel Storage, connect it to this project,
# and set MEDIA_STORAGE=blob only when BLOB_READ_WRITE_TOKEN is present.
# Older /api/media/<uuid> PostgreSQL images continue working unchanged.
MEDIA_STORAGE=database
BLOB_READ_WRITE_TOKEN=

# OPTIONAL: retain these only if you previously stored media in Cloudflare R2.
# They enable read-only compatibility for existing /api/media/<uuid> links.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
