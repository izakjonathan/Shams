# Optional until the final custom domain is connected.
# On Vercel, metadata automatically falls back to the current deployment URL.
NEXT_PUBLIC_SITE_URL=

# Keep false on previews. Change to true only for the public launch deployment.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Public ticket checkout URL. The site shows “Tickets soon” when omitted.
NEXT_PUBLIC_TICKET_URL=

# HTTPS form endpoint supplied by the final newsletter provider.
# The newsletter form remains visibly unavailable when omitted.
NEXT_PUBLIC_NEWSLETTER_FORM_ACTION=

# v2.1.0 admin and PostgreSQL foundation.
# The public site continues to use the validated local repository until the
# database adapter is explicitly enabled in a later release.
DATABASE_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Use a random value of at least 32 characters.
ADMIN_SESSION_SECRET=
