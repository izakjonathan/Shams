{
  "name": "shams-for-humanity",
  "version": "2.10.5",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "release:check": "npm run verify",
    "release:validate": "node scripts/validate-release.mjs",
    "audit:static": "node scripts/audit-static.mjs",
    "audit:boundaries": "node scripts/check-runtime-boundaries.mjs",
    "theme:generate": "node scripts/generate-theme.mjs",
    "predev": "npm run theme:generate",
    "prebuild": "npm run theme:generate && npm run audit:boundaries",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "test:e2e": "playwright test --project=chromium --project=webkit-mobile",
    "test:e2e:headed": "playwright test --project=chromium --project=webkit-mobile --headed",
    "test:visual": "playwright test --project=visual-chromium",
    "test:visual:update": "playwright test --project=visual-chromium --update-snapshots",
    "verify": "node scripts/verify-release.mjs",
    "db:verify": "node scripts/db-verify.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "db:align-publication": "node scripts/db-align-publication.mjs",
    "db:repair-records": "node scripts/db-repair-records.mjs",
    "lint": "eslint .",
    "test": "node --import tsx --test src/features/admin/tests/session.test.ts src/features/content/tests/validation.test.ts",
    "test:db": "node --conditions=react-server --import tsx --test src/features/admin/tests/database.test.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "next": "16.4.0",
    "postgres": "3.4.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@playwright/test": "1.62.0",
    "@types/node": "24.19.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": "24.x"
  }
}
