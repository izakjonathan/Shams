{
  "name": "shams-for-humanity",
  "version": "1.1.7",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "check": "npm run lint && npm run typecheck && npm run build",
    "release:check": "npm run release:validate && npm run lint && npm run typecheck && npm run build",
    "release:validate": "node scripts/validate-release.mjs"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "22.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "5.8.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.10",
    "@playwright/test": "1.57.0"
  },
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  }
}
